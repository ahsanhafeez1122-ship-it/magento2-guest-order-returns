<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="footer_links">
            <block class="Magento\Framework\View\Element\Html\Link\Current" name="guestreturns.footer.link" ifconfig="guest_returns/general/enabled">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Track or Return an Order</argument>
                    <argument name="path" xsi:type="string">guest-returns/lookup</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
